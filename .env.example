# Server Configuration
PORT=3000
SESSION_SECRET=your_random_secure_session_secret_change_me

# Admin Initial Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisPassword123!

# AI / Grok / Groq API Configuration
