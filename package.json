{
  "name": "youtube-playback-testing-bot",
  "version": "1.0.0",
  "description": "Private YouTube Playback QA & Browser Automation Testing Bot",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:client",
    "client:dev": "npm --prefix client run dev",
    "dev": "node server/index.js",
    "setup": "npm install && npm --prefix client install && npx playwright install chromium && npm run build"
  },
  "keywords": [
    "youtube",
    "playback",
    "qa",
    "testing",
    "playwright",
    "automation",
    "browser",
    "groq",
    "grok"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "playwright": "^1.64.1"
  }
}
